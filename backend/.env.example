# Copy to .env for local work. Every value here is read by app/config.py.
# Local default: fully offline (fake reader, in-memory storage, dev sign-in). No Google Cloud needed.
# Keep comments on their own lines: a comment after an empty value would be read as the value.

ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- AI ---------------------------------------------------------------------
# LLM_BACKEND: "fake" = offline reader for tests and UI work; "gemini" = Gemini on Gemini Enterprise
# Agent Platform with Application Default Credentials (gcloud auth application-default login).
LLM_BACKEND=fake
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Sends the ADK agents' own Gemini client to Agent Platform. The API also sets this for you when
# LLM_BACKEND=gemini. (GOOGLE_GENAI_USE_VERTEXAI is the deprecated name for the same switch.)
GOOGLE_GENAI_USE_ENTERPRISE=true
MODEL_FAST=gemini-3.8-flash
MODEL_PRO=gemini-3.1-pro-preview
MODEL_TTS=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore

# --- Storage ----------------------------------------------------------------
# STORE_BACKEND: memory | firestore
STORE_BACKEND=memory
# GRAPH_BACKEND: memory | spanner
GRAPH_BACKEND=memory
SPANNER_INSTANCE=
SPANNER_DATABASE=
# GCS_BUCKET: empty keeps uploads in memory (dev only)
GCS_BUCKET=

# --- Security ---------------------------------------------------------------
# AUTH_MODE: dev | firebase. Production refuses dev.
AUTH_MODE=dev
# In production these two come from Secret Manager (see infra/setup.sh). Never commit real values.
HASH_SALT=dev-only-salt-change-me
EVIDENCE_SIGNING_KEY=dev-only-signing-key-change-me
# KMS_KEY_VERSION: projects/P/locations/L/keyRings/R/cryptoKeys/K/cryptoKeyVersions/1 (empty = local HMAC)
KMS_KEY_VERSION=
USE_SENSITIVE_DATA_PROTECTION=false
# MODEL_ARMOR_TEMPLATE: projects/P/locations/L/templates/T (empty = local screen only)
MODEL_ARMOR_TEMPLATE=
# SCHEDULER_AUDIENCE: the API's https URL, as set on the Cloud Scheduler OIDC token
SCHEDULER_AUDIENCE=
# SCHEDULER_SERVICE_ACCOUNT: scheduler-invoker@P.iam.gserviceaccount.com
SCHEDULER_SERVICE_ACCOUNT=

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=12
MAX_FILES_PER_REQUEST=8

# --- Data -------------------------------------------------------------------
# PACKS_DIR: empty = bundled country packs
PACKS_DIR=
# RECRUITERS_CSV: empty = bundled fictional sample list
RECRUITERS_CSV=

# --- A2A --------------------------------------------------------------------
# PARTNER_AGENT_CARD_URL: a legal-aid partner's agent card; empty = approved hand-offs wait in the outbox
PARTNER_AGENT_CARD_URL=
